    "\n",
    "    data = discount_analysis[\n",
    "        [\"discount_pct\", column]\n",
    "    ].dropna()\n",
    "\n",
    "    rho, p = spearmanr(\n",
    "        data[\"discount_pct\"],\n",
    "        data[column]\n",
    "    )\n",
    "\n",
    "    print(name)\n",
    "    print(f\"Spearman ρ: {rho:.4f}\")\n",
    "    print(f\"P-value: {p:.4g}\")\n",
    "    print()"
   ]
