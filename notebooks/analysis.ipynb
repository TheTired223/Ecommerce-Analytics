    "from statsmodels.stats.oneway import anova_oneway\n",
    "\n",
    "groups = [\n",
    "    group[\"total_revenue\"].dropna().values\n",
    "    for _, group in customer_segment_analysis.groupby(\"customer_segment\")\n",
    "]\n",
    "\n",
    "welch_result = anova_oneway(\n",
    "    groups,\n",
    "    use_var=\"unequal\"\n",
    ")\n",
    "\n",
    "print(f\"Welch ANOVA statistic: {welch_result.statistic:.4f}\")\n",
    "print(f\"P-value: {welch_result.pvalue:.4g}\")"
   ]
  },
