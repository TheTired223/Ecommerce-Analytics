    "#Monthly Performance\n",
    "\n",
    "df_sales[\"order_month\"] = (\n",
    "    df_sales[\"order_date\"]\n",
    "    .dt.to_period(\"M\")\n",
    "    .dt.to_timestamp()\n",
    ")\n",
    "\n",
    "monthly_kpis = (\n",
    "    df_sales\n",
    "    .groupby(\"order_month\")\n",
    "    .agg(\n",
    "        revenue=(\"net_sales\", \"sum\"),\n",
    "        profit=(\"profit\", \"sum\"),\n",
    "        orders=(\"order_id\", \"nunique\"),\n",
    "        customers=(\"customer_id\", \"nunique\"),\n",
    "        units_sold=(\"quantity\", \"sum\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "monthly_kpis.head()"
   ]
