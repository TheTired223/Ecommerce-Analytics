    "#KPIS MONTHLY\n",
    "\n",
    "monthly_kpis[\"aov\"] = (\n",
    "    monthly_kpis[\"revenue\"]\n",
    "    / monthly_kpis[\"orders\"]\n",
    ")\n",
    "\n",
    "monthly_kpis[\"profit_margin\"] = (\n",
    "    monthly_kpis[\"profit\"]\n",
    "    / monthly_kpis[\"revenue\"]\n",
    ") * 100\n",
    "\n",
    "monthly_kpis[\"revenue_growth_pct\"] = (\n",
    "    monthly_kpis[\"revenue\"]\n",
    "    .pct_change() * 100\n",
    ")\n",
    "\n",
    "monthly_kpis[\"profit_growth_pct\"] = (\n",
    "    monthly_kpis[\"profit\"]\n",
    "    .pct_change() * 100\n",
    ")\n",
    "\n",
    "monthly_kpis"
   ]
  },
